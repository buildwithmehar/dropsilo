{
  "name": "dropsilo-backend",
  "version": "2.0.0",
  "description": "DropSilo media download API with live progress and optional Redis queue.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop easysave-backend",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.7",
    "archiver": "^8.0.0",
    "bullmq": "^5.13.2",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.4.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "license": "MIT",
  "overrides": {
    "archiver": {
      "readdir-glob": "4.0.0"
    }
  }
}
