# ── EasySave backend env vars ─────────────────────────────────────────────────
# Copy to `.env` and adjust as needed. Every variable below has a sensible
# default for single-instance local dev — production deployments must review.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3002
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── Storage ─────────────────────────────────────────────────────────────────
# Path is resolved relative to the backend's cwd. Default: ./temp
# TEMP_DIR=/var/easysave/temp
# Hard cap on the temp directory size (bytes). Default: 8 GB.
TEMP_DIR_MAX_BYTES=8589934592
# Disk space we must keep free system-wide before starting a new job (MB).
DISK_RESERVED_MB=1024

# ── Queue Driver ────────────────────────────────────────────────────────────
# `redis`  → BullMQ-backed queue. REQUIRED for PM2 cluster mode / multi-instance.
# `memory` → In-process queue. Default when REDIS_URL is unset.
# If you leave this unset, the runtime auto-selects `redis` when REDIS_URL is set.
# QUEUE_DRIVER=redis
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=easysave:downloads
REDIS_PUBSUB_CHANNEL=easysave:events

# ── Concurrency ────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=5

# ── Retry Policy ───────────────────────────────────────────────────────────
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_BACKOFF_BASE_MS=4000
# DOWNLOAD_BACKOFF_MAX_MS=60000

# ── Process Timeouts ───────────────────────────────────────────────────────
# EXTRACTION_TIMEOUT_MS=40000
# DOWNLOAD_TIMEOUT_MS=900000

# ── Download Tokens ────────────────────────────────────────────────────────
# REQUIRED in production. Any 48+ char random string is fine. Generate with:
#   openssl rand -base64 48
# If unset, a per-process random secret is used (tokens don't survive restart,
# and cluster workers won't agree on signatures).
FILE_TOKEN_SECRET=

# ── yt-dlp / ffmpeg / cookies / proxies ───────────────────────────────────
# Override binary lookup. Default: ./bin/yt-dlp + ./bin/ffmpeg, falling back
# to PATH lookup.
# YTDLP_PATH=./bin/yt-dlp
# FFMPEG_PATH=./bin/ffmpeg

# Optional engines. Bundled binaries and the bin/python-engines venv are
# discovered automatically. Use absolute paths for custom installs.
# ARIA2C_PATH=/usr/bin/aria2c
# NM3U8DL_RE_PATH=/usr/local/bin/N_m3u8DL-RE
# STREAMLINK_PATH=/usr/local/bin/streamlink
# GALLERY_DL_PATH=/usr/local/bin/gallery-dl
ARIA2_CONNECTIONS=8
DIRECT_DOWNLOAD_MAX_MB=512
LIVE_RECORD_SECONDS=60

# Optional operator downloads. This key is separate from API_KEYS.
# ADVANCED_API_KEY_FILE=C:/private/easysave/advanced.key
# RIPME_JAVA_PATH=C:/Program Files/Java/bin/java.exe
# RIPME_JAR_PATH=./bin/advanced/ripme.jar
# WGET_PATH=./bin/advanced/wget.exe
# HTTRACK_PATH=./bin/advanced/httrack/httrack/httrack.exe
# COURSE_PYTHON_PATH=./bin/advanced-python/Scripts/python.exe
# COURSERA_CAUTH_FILE=C:/private/easysave/coursera-cauth.txt
# UDEMY_BEARER_FILE=C:/private/easysave/udemy-bearer.txt
# STREAMRIP_CONFIG_PATH=C:/private/easysave/streamrip.toml
# OPENAUDIBLE_EXPORT_DIR=C:/private/audiobook-exports
# ANNAS_CLI_PATH=C:/local/tools/annas-mcp.exe
# ANNAS_SECRET_KEY_FILE=C:/private/easysave/anna-key.txt
# SCIHUB_BASE_URL=https://operator-configured-host.example
# SCIHUB_SCRIPT_PATH=C:/local/tools/scihub.py
# SPOTDL_PATH=./bin/advanced/spotdl.exe
# Optional cookies.txt file (exported from a logged-in browser session).
# Required for age-restricted, members-only, and certain private videos.
# COOKIES_FILE_PATH=./bin/cookies.txt
# Optional comma-separated list of HTTP(S) proxy URLs. Round-robins per job.
# Recommended for any deployment that does high-volume YouTube extraction.
# PROXY_URLS=http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080

# ── Rate Limits (per minute) ──────────────────────────────────────────────
RATE_LIMIT_HEALTH=600
RATE_LIMIT_EXTRACT=60
RATE_LIMIT_DOWNLOAD_START=30
RATE_LIMIT_DOWNLOAD_PROGRESS=60
RATE_LIMIT_DOWNLOAD_FILE=60
RATE_LIMIT_PROXY_STREAM=120
RATE_LIMIT_GLOBAL=240

# ── API Keys (optional) ───────────────────────────────────────────────────
# When set, every API request must include `X-Api-Key: <one-of-these>`.
# When present, rate limits are keyed by API key instead of client IP
# (useful for shared-NAT users: offices, schools, mobile carriers).
# API_KEYS=sk_live_abc123,sk_live_def456
